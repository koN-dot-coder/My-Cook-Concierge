#!/bin/bash
set -euo pipefail

rm -f tmp/pids/server.pid

# Initial compile so the first page load already has styles.
bundle exec rails tailwindcss:build

# "-w always" polls for changes (needed on Docker Desktop / Windows bind mounts).
bundle exec rails "tailwindcss:watch[always,verbose]" &
css_pid=$!

cleanup() {
  kill "$css_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

exec bundle exec rails server -p "${PORT:-3000}" -b "0.0.0.0"
