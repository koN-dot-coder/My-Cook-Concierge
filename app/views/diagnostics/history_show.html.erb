<% content_for :title, "#{@dish.name} | 診断履歴" %>

<div class="min-h-screen bg-[#FFF9F0] px-4 py-10">
  <div class="max-w-md mx-auto">
    <div class="mb-6">
      <%= link_to "← 履歴一覧に戻る", diagnostic_histories_path,
            class: "text-sm text-amber-800/70 hover:text-amber-900 transition-colors" %>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8 border border-amber-100">
      <div class="text-center mb-6">
        <p class="text-xs font-bold text-amber-600 tracking-wide mb-2">HISTORY</p>
        <p class="text-xs text-gray-400 mb-4">
          <%= l(@history.created_at, format: :long) %>
        </p>
        <h1 class="text-2xl font-extrabold text-gray-950 tracking-tight mb-3">
          <%= @dish.name %>
        </h1>
        <% if @dish.description.present? %>
          <p class="text-sm text-gray-600 leading-relaxed">
            <%= @dish.description %>
          </p>
        <% end %>
        <p class="inline-block mt-4 text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-full px-3 py-1">
          <%= @dish.category_label %>
        </p>
      </div>

      <div class="space-y-3 pt-4 border-t border-gray-100">
        <%= link_to "もう一度診断する", root_path,
              class: "block w-full py-4 px-6 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition-all text-base text-center" %>
      </div>
    </div>
  </div>
</div>
