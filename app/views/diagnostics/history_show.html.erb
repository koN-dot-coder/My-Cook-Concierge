<% content_for :title, "診断履歴 | My Cook Concierge" %>

<div class="min-h-screen bg-[#FFF9F0] text-amber-950 flex flex-col">
  <%= render "layouts/site_header" %>

  <main class="flex-1 max-w-6xl mx-auto w-full px-4 sm:px-6 py-10 pb-16">
    <div class="mb-6">
      <%= link_to "← 履歴一覧に戻る", diagnostic_histories_path,
            class: "text-sm text-amber-800/70 hover:text-amber-900 transition-colors" %>
    </div>

    <%= render "diagnostics/result_content",
          history_mode: true,
          course_label: @course_label,
          collected_tags: @collected_tags,
          dish: @dish,
          recommendations_by_category: @recommendations_by_category,
          favorite_dish_ids: @favorite_dish_ids,
          diagnosed_at: @diagnosed_at %>
  </main>

  <%= render "layouts/site_footer" %>
</div>
