<% content_for :title, "My Cook Concierge" %>

<div class="min-h-screen bg-[#FFF9F0] text-amber-950">
  <!-- Header -->
  <header class="bg-white/90 border-b border-amber-100/80 backdrop-blur-sm sticky top-0 z-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <%= link_to root_path, class: "text-lg sm:text-xl font-bold tracking-tight text-amber-900" do %>
        My Cook Concierge
      <% end %>
      <div class="w-9 h-9 rounded-full bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-800" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
          <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
        </svg>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
    <!-- Hero / course selection -->
    <section class="pt-12 sm:pt-16 pb-14 text-center">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-amber-950 mb-3">
        今日はどのくらい時間がありますか？
      </h1>
      <p class="text-sm sm:text-base text-amber-900/70 max-w-xl mx-auto mb-10">
        今の気分に合わせて、あなたにぴったりの一皿を見つけましょう。
      </p>

      <%= form_with url: diagnostics_start_path, method: :post, local: true do %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5 [&_form]:w-full">
          <%= button_tag type: "submit", name: "question_count", value: "10",
                class: "group w-full text-left sm:text-center bg-white rounded-2xl shadow-sm border border-amber-100/80 p-6 sm:p-8 hover:-translate-y-0.5 hover:shadow-md hover:border-amber-300 transition-all cursor-pointer" do %>
            <div class="flex sm:flex-col items-center gap-4 sm:gap-0">
              <div class="w-12 h-12 rounded-full bg-amber-50 text-amber-800 flex items-center justify-center shrink-0 sm:mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xl font-bold text-slate-800 group-hover:text-amber-900">かんたん</p>
                <p class="inline-block mt-2 text-xs font-semibold text-amber-800 bg-orange-100/80 rounded-full px-3 py-1">10の質問</p>
                <p class="mt-3 text-sm text-amber-900/60">サクッと手軽に</p>
              </div>
            </div>
          <% end %>

          <%= button_tag type: "submit", name: "question_count", value: "20",
                class: "group w-full text-left sm:text-center bg-white rounded-2xl shadow-sm border border-amber-100/80 p-6 sm:p-8 hover:-translate-y-0.5 hover:shadow-md hover:border-amber-300 transition-all cursor-pointer" do %>
            <div class="flex sm:flex-col items-center gap-4 sm:gap-0">
              <div class="w-12 h-12 rounded-full bg-amber-50 text-amber-800 flex items-center justify-center shrink-0 sm:mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5l2.25 15.75L12 18l6.75 2.25L21 4.5M8.25 9.75h7.5" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 4.5c0 1.5-.5 3-2 4.5M16 4.5c0 1.5.5 3 2 4.5" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xl font-bold text-slate-800 group-hover:text-amber-900">ふつう</p>
                <p class="inline-block mt-2 text-xs font-semibold text-amber-800 bg-orange-100/80 rounded-full px-3 py-1">20の質問</p>
                <p class="mt-3 text-sm text-amber-900/60">いつもの食事選びに</p>
              </div>
            </div>
          <% end %>

          <%= button_tag type: "submit", name: "question_count", value: "30",
                class: "group w-full text-left sm:text-center bg-white rounded-2xl shadow-sm border border-amber-100/80 p-6 sm:p-8 hover:-translate-y-0.5 hover:shadow-md hover:border-amber-300 transition-all cursor-pointer" do %>
            <div class="flex sm:flex-col items-center gap-4 sm:gap-0">
              <div class="w-12 h-12 rounded-full bg-amber-50 text-amber-800 flex items-center justify-center shrink-0 sm:mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25c-2.485 0-4.5.672-4.5 1.5S9.515 11.25 12 11.25s4.5-.672 4.5-1.5-2.015-1.5-4.5-1.5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 9.75v4.5c0 .828 2.015 1.5 4.5 1.5s4.5-.672 4.5-1.5v-4.5M7.5 14.25v2.25c0 .828 2.015 1.5 4.5 1.5s4.5-.672 4.5-1.5v-2.25" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xl font-bold text-slate-800 group-hover:text-amber-900">じっくり</p>
                <p class="inline-block mt-2 text-xs font-semibold text-amber-800 bg-orange-100/80 rounded-full px-3 py-1">30の質問</p>
                <p class="mt-3 text-sm text-amber-900/60">最高の満足感を求めて</p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <!-- Featured recipes -->
    <section class="pb-14">
      <div class="flex items-end justify-between mb-5">
        <h2 class="text-lg sm:text-xl font-bold text-amber-950">今日の注目レシピ</h2>
        <span class="text-sm text-amber-800/70 hover:text-amber-900 cursor-default">すべて見る</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5">
        <% @featured_recipes.each do |recipe| %>
          <article class="bg-white rounded-2xl shadow-sm border border-amber-100/70 overflow-hidden">
            <div class="aspect-[4/3] bg-sky-100/80 flex items-center justify-center text-sky-300">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
              </svg>
            </div>
            <div class="p-4">
              <h3 class="font-bold text-slate-800 text-sm sm:text-base leading-snug mb-2"><%= recipe[:title] %></h3>
              <p class="flex items-center gap-1.5 text-xs text-amber-900/55">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" />
                </svg>
                <%= recipe[:minutes] %>分
              </p>
            </div>
          </article>
        <% end %>
      </div>
    </section>

    <!-- Chef tips -->
    <section>
      <h2 class="text-lg sm:text-xl font-bold text-amber-950 mb-5">料理家の知恵袋</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
        <% @chef_tips.each do |tip| %>
          <article class="bg-white rounded-2xl shadow-sm border border-amber-100/70 p-5 flex gap-4 items-start">
            <div class="w-12 h-12 rounded-xl bg-orange-50 text-amber-800 flex items-center justify-center shrink-0">
              <% if tip[:icon] == "lightbulb" %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
                </svg>
              <% else %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6">
                  <circle cx="12" cy="12" r="8" />
                  <circle cx="12" cy="12" r="4.5" />
                  <circle cx="12" cy="12" r="1.5" fill="currentColor" />
                </svg>
              <% end %>
            </div>
            <div class="min-w-0 pt-0.5">
              <h3 class="font-bold text-slate-800 mb-1"><%= tip[:title] %></h3>
              <p class="text-sm text-amber-900/60 leading-relaxed"><%= tip[:body] %></p>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  </main>
</div>
