<%# locals: (history_mode:, course_label:, collected_tags:, dish:, recommendations_by_category:, favorite_dish_ids:, diagnosed_at: nil) %>
<div class="text-center mb-10">
  <p class="text-xs font-bold text-amber-600 tracking-widest mb-2">
    <%= history_mode ? "DIAGNOSIS HISTORY" : "DIAGNOSIS COMPLETE" %>
  </p>
  <h1 class="text-2xl sm:text-3xl font-extrabold text-amber-950 tracking-tight mb-3">
    <%= history_mode ? "あなたの専用メニュー" : "本日のあなた専用メニュー" %>
  </h1>
  <% if history_mode && diagnosed_at.present? %>
    <p class="text-xs text-amber-800/50 mb-2">
      <%= l(diagnosed_at, format: :long) %>
    </p>
  <% end %>
  <p class="text-sm text-amber-900/60 max-w-xl mx-auto">
    <% if history_mode %>
      <%= course_label %>の診断結果に基づき、診断時の気分と体調に合わせたメニューをご提案しました。
    <% else %>
      <%= course_label %>の診断結果に基づき、今の気分と体調に合わせたメニューをご提案します。
    <% end %>
  </p>
</div>

<% if dish.nil? %>
  <div class="bg-white rounded-2xl border border-amber-200 p-8 mb-10 text-center">
    <p class="text-sm text-amber-900/70 mb-2">おすすめメニューを表示する料理データがまだ登録されていません。</p>
    <p class="text-xs text-amber-800/50">開発環境では <code class="bg-amber-50 px-1.5 py-0.5 rounded">rails db:seed</code> を実行してください。</p>
  </div>
<% elsif dish %>
  <div class="bg-white rounded-3xl shadow-lg border border-amber-200 overflow-hidden mb-10">
    <div class="grid md:grid-cols-2 gap-0">
      <%= render "diagnostics/dish_placeholder", large: true %>
      <div class="p-8 flex flex-col justify-center">
        <p class="text-xs font-bold text-amber-600 mb-2">
          <%= history_mode ? "おすすめの一品" : "TODAY'S PICK" %>
        </p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-950 mb-3"><%= dish.name %></h2>
        <% if dish.description.present? %>
          <p class="text-sm text-gray-600 leading-relaxed mb-4"><%= dish.description %></p>
        <% end %>
        <span class="inline-block self-start text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-full px-3 py-1 mb-4">
          <%= dish.category_label %>
        </span>
        <div class="mb-6">
          <%= render "favorites/button", dish: dish, favorite_dish_ids: favorite_dish_ids %>
        </div>
        <% if dish.recipe_url.present? %>
          <%= link_to dish.recipe_url, target: "_blank", rel: "noopener",
                class: "inline-flex self-start items-center gap-2 py-3 px-6 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition text-sm" do %>
            レシピを見る →
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% Dish::CATEGORY_DISPLAY_ORDER.each do |category_key| %>
  <% section_dishes = recommendations_by_category[category_key] || [] %>
  <% next if section_dishes.empty? %>

  <section class="mb-10">
    <h2 class="text-lg font-bold text-amber-950 mb-4 pb-2 border-b border-amber-100">
      <%= Dish::CATEGORY_LABELS[category_key] %>
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% section_dishes.each do |section_dish| %>
        <article class="bg-white rounded-2xl shadow-sm border border-amber-100/80 overflow-hidden hover:shadow-md hover:border-amber-200 transition-all <%= section_dish == dish ? 'ring-2 ring-amber-400' : '' %>">
          <%= render "diagnostics/dish_placeholder" %>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 text-sm mb-1"><%= section_dish.name %></h3>
            <% if section_dish.description.present? %>
              <p class="text-xs text-gray-500 mb-2 line-clamp-2"><%= section_dish.description %></p>
            <% end %>
            <% if section_dish.tags.any? %>
              <div class="flex flex-wrap gap-1 mt-2">
                <% section_dish.tags.first(3).each do |tag| %>
                  <span class="text-[10px] font-semibold text-amber-700 bg-amber-50 rounded-full px-2 py-0.5"><%= tag_label(tag.name) %></span>
                <% end %>
              </div>
            <% end %>
            <div class="mt-3">
              <%= render "favorites/button", dish: section_dish, favorite_dish_ids: favorite_dish_ids %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<div class="bg-white rounded-2xl border border-amber-100 p-5 mb-8">
  <p class="text-xs font-bold text-gray-500 mb-2">マッチしたタグ</p>
  <div class="flex flex-wrap gap-2">
    <% collected_tags.each do |tag| %>
      <span class="inline-block text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-100 rounded-full px-3 py-1">#<%= tag_label(tag) %></span>
    <% end %>
  </div>
</div>

<div class="flex flex-col sm:flex-row gap-3 justify-center">
  <% if history_mode %>
    <%= link_to "履歴一覧に戻る", diagnostic_histories_path,
          class: "py-3.5 px-8 bg-white hover:bg-amber-50 text-amber-800 font-bold rounded-xl border-2 border-amber-200 transition text-center text-sm" %>
  <% else %>
    <% if authenticated? %>
      <%= link_to "過去の診断履歴を見る", diagnostic_histories_path,
            class: "py-3.5 px-8 bg-white hover:bg-amber-50 text-amber-800 font-bold rounded-xl border-2 border-amber-200 transition text-center text-sm" %>
    <% else %>
      <%= link_to "ログインして履歴を保存", new_session_path,
            class: "py-3.5 px-8 bg-white hover:bg-amber-50 text-amber-800 font-bold rounded-xl border-2 border-amber-200 transition text-center text-sm" %>
    <% end %>
  <% end %>
  <%= link_to "もう一度診断する", root_path,
        class: "py-3.5 px-8 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition text-center text-sm" %>
</div>
