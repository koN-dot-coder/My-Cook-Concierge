<% content_for :title, "質問 #{@current_question} | My Cook Concierge" %>

<div class="min-h-screen bg-[#FFF9F0] text-amber-950 flex flex-col">
  <%= render "layouts/site_header" %>

  <main class="flex-1 flex items-center justify-center px-4 py-10">
    <div class="max-w-lg w-full bg-white rounded-3xl shadow-xl border border-amber-100/80 p-8 sm:p-10">
      <div class="mb-8">
        <div class="flex items-center justify-between mb-2">
          <p class="text-xs font-bold text-amber-700 tracking-wide">
            Question <%= @current_question %> of <%= @question_count %>
          </p>
          <p class="text-xs text-amber-800/50"><%= @course_label %></p>
        </div>
        <div class="h-2 w-full bg-amber-50 rounded-full overflow-hidden">
          <div class="h-full bg-amber-500 rounded-full transition-all"
               style="width: <%= (@current_question.to_f / @question_count * 100).round %>%"></div>
        </div>
      </div>

      <div class="text-center mb-8">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-amber-950 tracking-tight mb-3">
          <%= @question[:text] %>
        </h1>
        <p class="text-sm text-amber-900/55"><%= @question[:hint] %></p>
      </div>

      <div class="space-y-3"
           data-controller="submit-once"
           data-action="click->submit-once#prepare:capture turbo:submit-start->submit-once#submitStart turbo:submit-end->submit-once#complete">
        <% @question[:choices].each do |choice| %>
          <%= button_to diagnostics_answer_path,
                method: :post,
                params: { choice_key: choice[:key] },
                form: { class: "w-full" },
                class: "w-full text-left p-4 bg-white border-2 border-amber-100 rounded-2xl hover:border-amber-400 hover:bg-amber-50/40 transition-all group cursor-pointer flex items-center gap-4" do %>
            <span class="w-12 h-12 rounded-xl bg-amber-50 text-2xl flex items-center justify-center shrink-0 group-hover:bg-amber-100 transition" aria-hidden="true">
              🍽️
            </span>
            <span class="min-w-0">
              <span class="block text-base font-bold text-gray-900 group-hover:text-amber-800 transition-colors">
                <%= choice[:label] %>
              </span>
              <span class="block text-xs text-amber-900/50 mt-1"><%= choice[:description] %></span>
            </span>
          <% end %>
        <% end %>
      </div>

      <div class="mt-8 pt-6 border-t border-amber-50">
        <%= link_to "← 戻る", root_path, class: "text-sm font-semibold text-amber-800/60 hover:text-amber-900 transition" %>
      </div>
    </div>
  </main>
</div>
