<% content_for :title, "質問 #{@current_question} | My Cook Concierge" %>

<div class="flex flex-col items-center justify-center min-h-screen bg-gray-50 px-4 py-10">
  <div class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8 border border-gray-100">

    <!-- 進捗 -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-2">
        <p class="text-xs font-bold text-amber-600 tracking-wide">
          QUESTION <%= @current_question %> / <%= @question_count %>
        </p>
        <p class="text-xs text-gray-400">
          <%= @course_label %>
        </p>
      </div>
      <div class="h-2 w-full bg-gray-100 rounded-full overflow-hidden">
        <div class="h-full bg-amber-500 rounded-full transition-all"
             style="width: <%= (@current_question.to_f / @question_count * 100).round %>%"></div>
      </div>
    </div>

    <!-- 質問本文 -->
    <div class="text-center mb-8">
      <h1 class="text-2xl font-extrabold text-gray-950 tracking-tight mb-3">
        <%= @question[:text] %>
      </h1>
      <p class="text-sm text-gray-500">
        <%= @question[:hint] %>
      </p>
    </div>

    <!-- 選択肢 -->
    <div class="space-y-3">
      <% @question[:choices].each do |choice| %>
        <%= button_to diagnostics_answer_path,
              method: :post,
              params: { choice_key: choice[:key] },
              form: { class: "w-full" },
              class: "w-full text-left p-4 bg-white border-2 border-gray-200 rounded-xl hover:border-amber-500 hover:bg-amber-50/30 transition-all group cursor-pointer" do %>
          <span class="block text-base font-bold text-gray-900 group-hover:text-amber-600 transition-colors">
            <%= choice[:label] %>
          </span>
          <span class="block text-xs text-gray-500 mt-1">
            <%= choice[:description] %>
          </span>
        <% end %>
      <% end %>
    </div>

    <div class="mt-8 pt-6 border-t border-gray-100">
      <%= link_to "トップに戻る", root_path, class: "block text-center text-sm text-gray-400 hover:text-amber-600 transition-colors" %>
    </div>
  </div>
</div>
