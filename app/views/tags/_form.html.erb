<%= form_with(model: tag, class: "space-y-5") do |form| %>
  <%= render "shared/error_messages", object: tag %>

  <div>
    <%= form.label :name, class: "block text-sm font-bold text-gray-800 mb-2" %>
    <%= form.text_field :name,
          class: "w-full rounded-xl border bg-white px-4 py-3 text-gray-900 focus:ring-2 outline-none transition #{tag.errors[:name].any? ? 'border-red-300 focus:border-red-400 focus:ring-red-100' : 'border-amber-100 focus:border-amber-400 focus:ring-amber-200'}",
          placeholder: "例: 和食" %>
    <% if tag.errors[:name].any? %>
      <p class="mt-2 text-xs font-semibold text-red-600"><%= tag.errors.full_messages_for(:name).first %></p>
    <% end %>
  </div>

  <div class="flex flex-col sm:flex-row gap-3 pt-2">
    <%= form.submit class: "w-full sm:w-auto py-3 px-8 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition-all cursor-pointer border-0" %>
    <%= link_to "キャンセル", tags_path,
          class: "w-full sm:w-auto py-3 px-8 bg-white hover:bg-amber-50 text-amber-800 font-bold rounded-xl border-2 border-amber-200 transition-all text-center" %>
  </div>
<% end %>
