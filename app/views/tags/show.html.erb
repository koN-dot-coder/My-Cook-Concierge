<% content_for :title, "#{tag_label(@tag.name)} | My Cook Concierge" %>

<div class="min-h-screen bg-[#FFF9F0] px-4 py-10">
  <div class="max-w-2xl mx-auto">
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <%= link_to "← 一覧に戻る", tags_path, class: "text-sm text-amber-800/70 hover:text-amber-900 transition-colors" %>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8 border border-amber-100">
      <div class="mb-6">
        <span class="inline-block text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-full px-3 py-1 mb-3">
          タグ
        </span>
        <h1 class="text-2xl font-extrabold text-gray-950 tracking-tight"><%= tag_label(@tag.name) %></h1>
        <p class="text-xs text-gray-400 mt-1"><%= @tag.name %></p>
      </div>

      <div class="mb-8">
        <p class="text-xs font-bold text-gray-500 mb-2">関連する料理</p>
        <% if @tag.dishes.any? %>
          <ul class="space-y-2">
            <% @tag.dishes.each do |dish| %>
              <li>
                <%= link_to dish.name, dish_path(dish),
                      class: "text-sm text-amber-700 hover:text-amber-900 font-medium transition-colors" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-gray-500">このタグが付いた料理はまだありません</p>
        <% end %>
      </div>

      <% if admin? %>
        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100">
          <%= link_to "編集する", edit_tag_path(@tag),
                class: "flex-1 py-3 px-6 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition-all text-center" %>
          <%= button_to "削除する", tag_path(@tag),
                method: :delete,
                form: { class: "flex-1" },
                class: "w-full py-3 px-6 bg-red-500 hover:bg-red-600 text-white font-bold rounded-xl shadow-sm transition-all cursor-pointer border-0",
                data: { turbo_confirm: "本当に削除しますか？" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
