<%# locals: (form:, field:, label:, icon: nil, object: nil, **html_options) %>
<% object ||= form.object %>
<% has_error = object.respond_to?(:errors) && object.errors[field].any? %>
<% base_class = "w-full rounded-xl border border-amber-100 bg-white py-3 text-gray-900 focus:border-amber-400 focus:ring-2 focus:ring-amber-200 outline-none transition" %>
<% padding_class = icon.present? ? "pl-11 pr-12" : "px-4 pr-12" %>

<div>
  <%= form.label field, label, class: "block text-sm font-bold text-gray-800 mb-2" %>
  <div class="relative" data-controller="password-visibility">
    <% if icon.present? %>
      <span class="absolute left-4 top-1/2 -translate-y-1/2 text-amber-400" aria-hidden="true"><%= icon %></span>
    <% end %>
    <%= form.password_field field,
          **html_options,
          class: "#{base_class} #{padding_class} #{has_error ? 'border-red-300' : ''}",
          data: { password_visibility_target: "input" } %>
    <button type="button"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-amber-500 hover:text-amber-700 p-1 rounded-md transition"
            data-password-visibility-target="toggle"
            data-action="password-visibility#toggle"
            aria-label="パスワードを表示">
      <svg data-password-visibility-target="showIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <svg data-password-visibility-target="hideIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5 hidden" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12c1.292 2.4 4.003 4.5 7.066 4.5 1.06 0 2.07-.22 2.99-.61M6.228 6.228A10.45 10.45 0 0112 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639a10.46 10.46 0 01-4.132 3.745M6.228 6.228L3 3m3.228 3.228l13.544 13.544M21 21l-2.772-2.772" />
      </svg>
    </button>
  </div>
  <% if has_error %>
    <p class="mt-1.5 text-xs font-semibold text-red-600"><%= object.errors.full_messages_for(field).first %></p>
  <% end %>
</div>
