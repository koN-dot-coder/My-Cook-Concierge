<% content_for :title, "アカウント設定 | My Cook Concierge" %>

<div class="min-h-screen bg-[#FFF9F0] flex flex-col">
  <%= render "layouts/site_header" %>

  <main class="flex-1 max-w-lg mx-auto w-full px-4 sm:px-6 py-10 pb-16">
    <div class="mb-8">
      <%= link_to "← トップに戻る", root_path, class: "text-sm text-amber-800/70 hover:text-amber-900 transition-colors" %>
      <h1 class="text-2xl font-extrabold text-amber-950 tracking-tight mt-4">アカウント設定</h1>
      <p class="text-sm text-amber-900/60 mt-2">お名前とパスワードを変更できます</p>
    </div>

    <div class="bg-white rounded-3xl shadow-xl border border-amber-100/80 p-8">
      <%= render "shared/error_messages", object: @user %>

      <%= form_with model: @user, url: account_path, method: :patch, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :name, "お名前", class: "block text-sm font-bold text-gray-800 mb-2" %>
          <%= form.text_field :name,
                class: "w-full rounded-xl border border-amber-100 bg-white px-4 py-3 text-gray-900 focus:border-amber-400 focus:ring-2 focus:ring-amber-200 outline-none transition #{@user.errors[:name].any? ? 'border-red-300' : ''}" %>
        </div>

        <div>
          <p class="text-sm font-bold text-gray-800 mb-1">メールアドレス</p>
          <p class="text-sm text-gray-600"><%= @user.email_address %></p>
          <p class="text-xs text-amber-800/50 mt-1">メールアドレスの変更は現在サポートしていません</p>
        </div>

        <div class="border-t border-amber-100 pt-6">
          <h2 class="text-sm font-bold text-gray-800 mb-4">パスワードの変更（任意）</h2>
          <div class="space-y-4">
            <%= render "shared/password_field", form: form, field: :password, label: "新しいパスワード",
                  object: @user, autocomplete: "new-password", maxlength: 72, placeholder: "変更する場合のみ入力" %>

            <%= render "shared/password_field", form: form, field: :password_confirmation, label: "新しいパスワード（確認）",
                  object: @user, autocomplete: "new-password", maxlength: 72, placeholder: "もう一度入力してください" %>
          </div>
        </div>

        <%= form.submit "変更を保存する",
              class: "w-full py-3.5 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition cursor-pointer border-0" %>
      <% end %>
    </div>

    <div class="mt-8 bg-white rounded-3xl shadow-sm border border-red-100 p-8">
      <h2 class="text-sm font-bold text-red-700 mb-2">アカウントの削除</h2>
      <p class="text-sm text-gray-600 mb-4 leading-relaxed">
        アカウントを削除すると、お気に入りと診断履歴もすべて消えます。この操作は取り消せません。
      </p>
      <%= button_to "アカウントを削除する",
            account_path,
            method: :delete,
            form: { class: "w-full" },
            class: "w-full py-3.5 bg-white hover:bg-red-50 text-red-600 font-bold rounded-xl border-2 border-red-200 hover:border-red-300 transition cursor-pointer",
            data: { turbo_confirm: "本当にアカウントを削除しますか？\nお気に入りと診断履歴もすべて削除されます。" } %>
    </div>
  </main>

  <%= render "layouts/site_footer" %>
</div>
