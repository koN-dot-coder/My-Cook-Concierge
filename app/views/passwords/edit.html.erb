<% content_for :title, "新しいパスワード | My Cook Concierge" %>

<div class="min-h-screen bg-[#FFF9F0] flex items-center justify-center px-4 py-10">
  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-amber-100/80 p-8 sm:p-10">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-extrabold text-amber-900 tracking-tight">新しいパスワードを設定</h1>
      <p class="text-sm text-amber-900/60 mt-2">8文字以上の新しいパスワードを入力してください。</p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :password, "新しいパスワード", class: "block text-sm font-bold text-gray-800 mb-2" %>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-amber-400" aria-hidden="true">🔒</span>
          <%= form.password_field :password,
                required: true,
                autocomplete: "new-password",
                placeholder: "8文字以上の半角英数字",
                maxlength: 72,
                class: "w-full rounded-xl border border-amber-100 bg-white pl-11 pr-4 py-3 text-gray-900 focus:border-amber-400 focus:ring-2 focus:ring-amber-200 outline-none transition" %>
        </div>
      </div>

      <div>
        <%= form.label :password_confirmation, "新しいパスワード（確認）", class: "block text-sm font-bold text-gray-800 mb-2" %>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-amber-400" aria-hidden="true">↻</span>
          <%= form.password_field :password_confirmation,
                required: true,
                autocomplete: "new-password",
                placeholder: "もう一度入力してください",
                maxlength: 72,
                class: "w-full rounded-xl border border-amber-100 bg-white pl-11 pr-4 py-3 text-gray-900 focus:border-amber-400 focus:ring-2 focus:ring-amber-200 outline-none transition" %>
        </div>
      </div>

      <%= form.submit "パスワードを変更する",
            class: "w-full py-3.5 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition cursor-pointer border-0" %>
    <% end %>

    <p class="text-center text-sm text-amber-900/60 mt-8">
      <%= link_to "ログインに戻る", new_session_path,
            class: "font-bold text-amber-700 hover:text-amber-900 transition" %>
    </p>
  </div>
</div>
