<% content_for :title, "ログイン | My Cook Concierge" %>

<div class="min-h-screen bg-[#FFF9F0] flex flex-col">
  <div class="flex-1 flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-md">
      <div class="bg-white rounded-3xl shadow-xl border border-amber-100/80 overflow-hidden">
        <div class="h-36 bg-gradient-to-br from-amber-100 via-orange-50 to-amber-50 flex items-center justify-center">
          <span class="text-5xl" aria-hidden="true">🍳</span>
        </div>

        <div class="p-8 sm:p-10">
          <div class="text-center mb-8">
            <h1 class="text-2xl font-extrabold text-amber-900 tracking-tight">My Cook Concierge</h1>
            <p class="text-sm text-amber-900/60 mt-2 leading-relaxed">
              お帰りなさいませ。ログインして<br class="hidden sm:inline">本日のメニューを確認しましょう。
            </p>
          </div>

          <%= form_with url: session_path, class: "space-y-5" do |form| %>
            <div>
              <%= form.label :email_address, "メールアドレス", class: "block text-sm font-bold text-gray-800 mb-2" %>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-amber-400" aria-hidden="true">✉</span>
                <%= form.email_field :email_address,
                      required: true,
                      autofocus: true,
                      autocomplete: "username",
                      placeholder: "your@email.com",
                      value: params[:email_address],
                      class: "w-full rounded-xl border border-amber-100 bg-white pl-11 pr-4 py-3 text-gray-900 focus:border-amber-400 focus:ring-2 focus:ring-amber-200 outline-none transition" %>
              </div>
            </div>

            <div>
              <%= form.label :password, "パスワード", class: "block text-sm font-bold text-gray-800 mb-2" %>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-amber-400" aria-hidden="true">🔒</span>
                <%= form.password_field :password,
                      required: true,
                      autocomplete: "current-password",
                      maxlength: 72,
                      placeholder: "パスワードを入力",
                      class: "w-full rounded-xl border border-amber-100 bg-white pl-11 pr-4 py-3 text-gray-900 focus:border-amber-400 focus:ring-2 focus:ring-amber-200 outline-none transition" %>
              </div>
            </div>

            <%= form.submit "ログイン",
                  class: "w-full py-3.5 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition cursor-pointer border-0" %>
          <% end %>

          <p class="text-center text-sm text-amber-900/60 mt-8">
            アカウントをお持ちでないですか？
            <%= link_to "新規登録はこちら", new_registration_path,
                  class: "font-bold text-amber-700 hover:text-amber-900 transition" %>
          </p>
        </div>
      </div>

      <p class="text-center mt-6">
        <%= link_to "← トップに戻る", root_path, class: "text-sm text-amber-800/70 hover:text-amber-900 transition" %>
      </p>
    </div>
  </div>
</div>
