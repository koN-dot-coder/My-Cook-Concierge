<% content_for :title, "料理一覧 | My Cook Concierge" %>

<div class="min-h-screen bg-[#FFF9F0] px-4 py-10">
  <div class="max-w-4xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <%= link_to "← トップに戻る", root_path, class: "text-sm text-amber-800/70 hover:text-amber-900 transition-colors" %>
        <h1 class="text-2xl font-extrabold text-amber-950 tracking-tight mt-4">料理データ管理</h1>
        <p class="text-sm text-amber-900/60 mt-2">登録されている料理の一覧・編集</p>
      </div>
      <%= link_to "新規追加",
            new_dish_path,
            class: "inline-block py-3 px-6 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition-all text-center" if admin? %>
    </div>

    <% if @dishes.any? %>
      <div class="bg-white rounded-2xl shadow-sm border border-amber-100/80 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead class="bg-amber-50/80 border-b border-amber-100">
              <tr>
                <th class="px-5 py-3 text-xs font-bold text-amber-900">料理名</th>
                <th class="px-5 py-3 text-xs font-bold text-amber-900">カテゴリ</th>
                <th class="px-5 py-3 text-xs font-bold text-amber-900 text-right">操作</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-amber-50">
              <% @dishes.each do |dish| %>
                <tr class="hover:bg-amber-50/30 transition-colors">
                  <td class="px-5 py-4">
                    <%= link_to dish.name, dish_path(dish),
                          class: "font-bold text-gray-900 hover:text-amber-700 transition-colors" %>
                    <% if dish.description.present? %>
                      <p class="text-xs text-gray-500 mt-1 line-clamp-1"><%= dish.description %></p>
                    <% end %>
                  </td>
                  <td class="px-5 py-4">
                    <span class="inline-block text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-100 rounded-full px-3 py-1">
                      <%= dish.category_label %>
                    </span>
                  </td>
                  <td class="px-5 py-4">
                    <div class="flex items-center justify-end gap-2">
                      <%= link_to "詳細", dish_path(dish),
                            class: "text-xs font-bold text-amber-700 hover:text-amber-900 px-3 py-2 rounded-lg hover:bg-amber-50 transition" %>
                      <% if admin? %>
                        <%= link_to "編集", edit_dish_path(dish),
                              class: "text-xs font-bold text-amber-700 hover:text-amber-900 px-3 py-2 rounded-lg hover:bg-amber-50 transition" %>
                        <%= button_to "削除", dish_path(dish),
                              method: :delete,
                              form: { class: "inline-block" },
                              class: "text-xs font-bold text-red-600 hover:text-red-700 px-3 py-2 rounded-lg hover:bg-red-50 transition cursor-pointer border-0 bg-transparent",
                              data: { turbo_confirm: "本当に削除しますか？" } %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <%= paginate @dishes %>
    <% else %>
      <div class="bg-white rounded-2xl shadow-sm border border-amber-100/80 p-10 text-center">
        <p class="text-gray-600 mb-6">まだ料理が登録されていません</p>
        <% if admin? %>
          <%= link_to "最初の料理を追加する", new_dish_path,
                class: "inline-block py-3 px-6 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition-all" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
