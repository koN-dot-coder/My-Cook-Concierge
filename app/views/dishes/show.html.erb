<% content_for :title, "#{@dish.name} | My Cook Concierge" %>

<div class="min-h-screen bg-[#FFF9F0] px-4 py-10">
  <div class="max-w-2xl mx-auto">
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <%= link_to "← 一覧に戻る", dishes_path, class: "text-sm text-amber-800/70 hover:text-amber-900 transition-colors" %>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8 border border-amber-100">
      <div class="mb-6">
        <span class="inline-block text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-full px-3 py-1 mb-3">
          <%= @dish.category_label %>
        </span>
        <h1 class="text-2xl font-extrabold text-gray-950 tracking-tight"><%= @dish.name %></h1>
      </div>

      <div class="mb-6">
        <p class="text-xs font-bold text-gray-500 mb-2">タグ</p>
        <% if @dish.tags.any? %>
          <div class="flex flex-wrap gap-2">
            <% @dish.tags.each do |tag| %>
              <%= link_to tag_path(tag),
                    class: "inline-block text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-full px-3 py-1 hover:bg-amber-100 hover:border-amber-300 transition-colors" do %>
                <%= tag.name %>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">タグはまだ設定されていません</p>
        <% end %>
      </div>

      <% if @dish.description.present? %>
        <div class="mb-6">
          <p class="text-xs font-bold text-gray-500 mb-2">説明</p>
          <p class="text-sm text-gray-700 leading-relaxed"><%= @dish.description %></p>
        </div>
      <% end %>

      <% if @dish.image_url.present? %>
        <div class="mb-6">
          <p class="text-xs font-bold text-gray-500 mb-2">画像URL</p>
          <%= link_to @dish.image_url, @dish.image_url, target: "_blank", rel: "noopener",
                class: "text-sm text-amber-700 hover:text-amber-900 break-all" %>
        </div>
      <% end %>

      <% if @dish.recipe_url.present? %>
        <div class="mb-8">
          <p class="text-xs font-bold text-gray-500 mb-2">レシピURL</p>
          <%= link_to @dish.recipe_url, @dish.recipe_url, target: "_blank", rel: "noopener",
                class: "text-sm text-amber-700 hover:text-amber-900 break-all" %>
        </div>
      <% end %>

      <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100">
        <%= link_to "編集する", edit_dish_path(@dish),
              class: "flex-1 py-3 px-6 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md transition-all text-center" %>
        <%= button_to "削除する", dish_path(@dish),
              method: :delete,
              form: { class: "flex-1" },
              class: "w-full py-3 px-6 bg-red-500 hover:bg-red-600 text-white font-bold rounded-xl shadow-sm transition-all cursor-pointer border-0",
              data: { turbo_confirm: "本当に削除しますか？" } %>
      </div>
    </div>
  </div>
</div>
