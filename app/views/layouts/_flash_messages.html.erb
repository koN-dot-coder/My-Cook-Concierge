<% if notice.present? || alert.present? %>
  <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-3 w-full max-w-md px-4 pointer-events-none" aria-live="polite">
    <% if notice.present? %>
      <div
        data-controller="flash"
        data-flash-delay-value="3000"
        role="status"
        class="pointer-events-auto flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50/95 px-4 py-3.5 text-amber-950 shadow-lg backdrop-blur-sm opacity-0 -translate-y-4 transition-all duration-300 ease-out">
        <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-500 text-xs font-bold text-white" aria-hidden="true">✓</span>
        <p class="flex-1 text-sm font-semibold leading-relaxed"><%= notice %></p>
        <button
          type="button"
          data-action="flash#dismiss"
          class="shrink-0 rounded-lg p-1 text-amber-700/70 hover:bg-amber-100 hover:text-amber-900 transition-colors"
          aria-label="通知を閉じる">
          <span aria-hidden="true">×</span>
        </button>
      </div>
    <% end %>

    <% if alert.present? %>
      <div
        data-controller="flash"
        data-flash-delay-value="3000"
        role="alert"
        class="pointer-events-auto flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50/95 px-4 py-3.5 text-red-900 shadow-lg backdrop-blur-sm opacity-0 -translate-y-4 transition-all duration-300 ease-out">
        <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-500 text-xs font-bold text-white" aria-hidden="true">!</span>
        <p class="flex-1 text-sm font-semibold leading-relaxed"><%= alert %></p>
        <button
          type="button"
          data-action="flash#dismiss"
          class="shrink-0 rounded-lg p-1 text-red-700/70 hover:bg-red-100 hover:text-red-900 transition-colors"
          aria-label="通知を閉じる">
          <span aria-hidden="true">×</span>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
